rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Open during login (read credentials + child lookup before Firebase Auth) ──
    match /users/{userId} {
      allow read, write: if true;
    }

    match /children/{childId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Require Firebase Auth (set after login via syncFirebaseAuth) ──────────
    match /exercise_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /weekly_schedules/{scheduleId} {
      allow read, write: if request.auth != null;
    }

    match /note_patterns/{patternId} {
      allow read, write: if request.auth != null;
    }

    match /checklist_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // ── Mixed (browser + Next.js API routes — API routes have no Firebase Auth) ──
    match /video_modeling/{videoId} {
      allow read, write: if true;
    }

    match /video_analysis/{analysisId} {
      allow read, write: if true;
    }

    match /video_analysis/{analysisId}/history/{historyId} {
      allow read, write: if true;
    }

    match /hpdt_stats/{statId} {
      allow read, write: if true;
    }

    match /hpdt_stats/{statId}/history/{historyId} {
      allow read, write: if true;
    }

    match /lessons/{lessonId} {
      allow read, write: if true;
    }

    match /collaboration_tasks/{taskId} {
      allow read, write: if true;
    }

    // ── Teacher school/learner lookups ────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }

    match /child_documents/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
